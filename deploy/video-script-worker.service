[Unit]
Description=Video Pipeline Antigravity script worker

[Service]
Type=simple
WorkingDirectory=REPO_CHECKOUT/backend
EnvironmentFile=%h/.config/video-pipeline/worker.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=VENV_RQ worker --url ${REDIS_URL} --name pipeline-worker default
Restart=on-failure
RestartSec=5
TimeoutStopSec=330

[Install]
WantedBy=default.target
