[Unit]
Description=Video Pipeline Antigravity script worker

[Service]
Type=simple
WorkingDirectory=REPO_CHECKOUT/backend
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=VENV_PYTHON -m app.worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=330

[Install]
WantedBy=default.target
